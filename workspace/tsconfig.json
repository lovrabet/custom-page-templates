{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/context/app-context": ["./src/app-context.tsx"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
